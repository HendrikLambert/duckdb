# name: test/sql/storage/compression/bitpacking/bitpacking_group_offset.test
# description: A bitpacking group offset pointing outside the segment's data region must error, not crash
# group: [bitpacking]

require vector_size 2048

unzip data/storage/corrupt/bitpacking_group_offset.db.gz {TEST_DIR}/bitpacking_group_offset.db

load {TEST_DIR}/bitpacking_group_offset.db readonly

query I
SELECT compression FROM pragma_storage_info('t') WHERE column_name='a' AND compression='BitPacking';
----
BitPacking

statement error
SELECT sum(a) FROM t;
----
Data Corruption Error: Corrupted bitpacking segment: offset is outside the segment

restart

statement ok
SET debug_force_fetch_row=true;

statement error
SELECT sum(a) FROM t;
----
Data Corruption Error: Corrupted bitpacking segment: offset is outside the segment
