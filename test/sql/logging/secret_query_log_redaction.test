# name: test/sql/logging/secret_query_log_redaction.test
# description: Secret creation is redacted in query logs and query log files
# group: [logging]

require noforcestorage

require skip_reload

# The test runner permits unredacted secrets at database creation.
statement ok
CALL enable_logging('QueryLog', storage = 'memory');

statement ok
CREATE SECRET log_unredacted (TYPE HTTP, BEARER_TOKEN 'dummy-unredacted-token');

query T
SELECT message FROM duckdb_logs WHERE type = 'QueryLog' AND starts_with(message, 'CREATE SECRET log_unredacted');
----
CREATE SECRET log_unredacted (TYPE HTTP, BEARER_TOKEN 'dummy-unredacted-token');

statement ok
CALL disable_logging();

statement ok
SET allow_unredacted_secrets = false;

# Verification can replace the parsed statement before it reaches the logger.
foreach verification NONE COPY_STATEMENT REPARSE_STATEMENT

statement ok
SET debug_verify_statement = '{verification}';

statement ok
CALL truncate_duckdb_logs();

statement ok
CALL enable_logging('QueryLog', storage = 'memory');

statement ok
SET log_query_path = '{TEST_DIR}/secret_query_{verification}.log';

statement ok
CREATE SECRET log_secret_{verification} (
    TYPE HTTP,
    PROVIDER CONFIG,
    SCOPE 'https://dummy-scope.example/',
    BEARER_TOKEN 'dummy-original-token',
    EXTRA_HTTP_HEADERS MAP {'Authorization': 'dummy-header-token'}
);

statement ok
CREATE OR REPLACE SECRET log_secret_{verification} (TYPE HTTP, BEARER_TOKEN 'dummy-replacement-token');

statement ok
EXPLAIN CREATE SECRET log_explained_{verification} (TYPE HTTP, BEARER_TOKEN 'dummy-explain-token');

# Binding errors occur after query logging, so these statements must also be redacted.
statement error
CREATE SECRET log_invalid_{verification} (TYPE HTTP, UNKNOWN_OPTION 'dummy-invalid-token');
----
Unknown parameter "unknown_option"

query I
select  42 /* keep formatting */ AS answer;
----
42

statement ok
SET log_query_path = '';

statement ok
CALL disable_logging();

query III
SELECT count(*), bool_and(NOT contains(message, 'dummy-')), bool_and(contains(message, '''redacted'''))
FROM duckdb_logs
WHERE type = 'QueryLog' AND (starts_with(message, 'CREATE') OR starts_with(message, 'EXPLAIN'));
----
4	true	true

# Unchanged SQL keeps its original whitespace and comments.
query I
SELECT count(*) FROM duckdb_logs WHERE type = 'QueryLog' AND message = 'select  42 /* keep formatting */ AS answer;';
----
1

query III
SELECT NOT contains(content, 'dummy-'), contains(content, '''redacted'''),
       contains(content, 'select  42 /* keep formatting */ AS answer;')
FROM read_text('{TEST_DIR}/secret_query_{verification}.log');
----
true	true	true

endloop

statement ok
RESET debug_verify_statement;
