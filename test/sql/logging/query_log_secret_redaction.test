# name: test/sql/logging/query_log_secret_redaction.test
# description: Redact secret creation in query logs while preserving ordinary SQL
# group: [logging]

require noforcestorage

statement ok
CALL enable_logging('QueryLog', storage = 'memory');

statement ok
CREATE SECRET visible_secret (TYPE http, BEARER_TOKEN 'visible-token');

statement ok
CALL disable_logging();

query I
SELECT (count(*) > 0) = current_setting('allow_unredacted_secrets') FROM duckdb_logs WHERE type = 'QueryLog' AND contains(message, 'visible-token');
----
true

statement ok
CALL truncate_duckdb_logs();

statement ok
SET allow_unredacted_secrets = false;

statement ok
CALL enable_logging('QueryLog', storage = 'memory');

statement ok
SET log_query_path = '{TEST_DIR}/query_log_secret_redaction.txt';

statement ok
CREATE SECRET logged_secret (TYPE http, BEARER_TOKEN 'private-token', SCOPE 'https://example.com/private-scope');

# Redaction must also apply when binding fails.
statement error
CREATE SECRET invalid_logged_secret (TYPE http, VERIFY_SSL 'private-invalid-value');
----
Failed to cast option

statement ok
EXPLAIN CREATE SECRET explained_secret (TYPE http, BEARER_TOKEN 'private-explained-token');

statement ok
SELECT   42 AS preserved_spacing;

statement ok
PREPARE ordinary_query AS SELECT $1;

statement ok
EXECUTE ordinary_query('ordinary-value');

statement ok
SET log_query_path = '';

statement ok
CALL disable_logging();

query I
SELECT count(*) FROM duckdb_logs WHERE type = 'QueryLog' AND contains(message, 'private-');
----
0

query I
SELECT count(*) FROM duckdb_logs WHERE type = 'QueryLog' AND contains(message, 'SECRET') AND contains(message, 'redacted');
----
3

query I
SELECT count(*) FROM duckdb_logs WHERE type = 'QueryLog' AND message = 'SELECT   42 AS preserved_spacing;';
----
1

query I
SELECT count(*) FROM duckdb_logs WHERE type = 'QueryLog' AND message = 'EXECUTE ordinary_query(''ordinary-value'');';
----
1

query I
SELECT count(*) FROM read_text('{TEST_DIR}/query_log_secret_redaction.txt') WHERE contains(content, 'private-');
----
0

query I
SELECT count(*) FROM read_text('{TEST_DIR}/query_log_secret_redaction.txt') WHERE contains(content, 'redacted');
----
1

query I
SELECT scope FROM duckdb_secrets() WHERE name = 'logged_secret';
----
[https://example.com/private-scope]
