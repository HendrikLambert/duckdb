@@ -169,6 +169,79 @@ CURLURLHandle::~CURLURLHandle() {
 	curl_url_cleanup(handle);
 }
 
+static HTTPRequestError GetRequestError(CURLcode result, int os_errno) {
+	HTTPRequestError error;
+	switch (result) {
+	case CURLE_OPERATION_TIMEDOUT:
+		error.type = HTTPRequestErrorType::TIMEOUT;
+		break;
+	case CURLE_COULDNT_RESOLVE_PROXY:
+	case CURLE_COULDNT_RESOLVE_HOST:
+	case CURLE_COULDNT_CONNECT:
+	case CURLE_INTERFACE_FAILED:
+	case CURLE_QUIC_CONNECT_ERROR:
+	case CURLE_PROXY:
+		error.type = HTTPRequestErrorType::CONNECT;
+		break;
+	case CURLE_SSL_CONNECT_ERROR:
+	case CURLE_SSL_ENGINE_NOTFOUND:
+	case CURLE_SSL_ENGINE_SETFAILED:
+	case CURLE_SSL_ENGINE_INITFAILED:
+	case CURLE_PEER_FAILED_VERIFICATION:
+	case CURLE_SSL_CERTPROBLEM:
+	case CURLE_SSL_CIPHER:
+	case CURLE_SSL_CACERT_BADFILE:
+	case CURLE_SSL_CRL_BADFILE:
+	case CURLE_SSL_ISSUER_ERROR:
+	case CURLE_SSL_PINNEDPUBKEYNOTMATCH:
+	case CURLE_SSL_INVALIDCERTSTATUS:
+	case CURLE_SSL_CLIENTCERT:
+	case CURLE_ECH_REQUIRED:
+		error.type = HTTPRequestErrorType::TLS;
+		break;
+	case CURLE_SEND_ERROR:
+	case CURLE_RECV_ERROR:
+	case CURLE_GOT_NOTHING:
+	case CURLE_PARTIAL_FILE:
+	case CURLE_SSL_SHUTDOWN_FAILED:
+	case CURLE_HTTP2:
+	case CURLE_HTTP2_STREAM:
+	case CURLE_HTTP3:
+	case CURLE_UNRECOVERABLE_POLL:
+		error.type = HTTPRequestErrorType::TRANSPORT;
+		break;
+	case CURLE_UNSUPPORTED_PROTOCOL:
+	case CURLE_FAILED_INIT:
+	case CURLE_URL_MALFORMAT:
+	case CURLE_NOT_BUILT_IN:
+	case CURLE_WEIRD_SERVER_REPLY:
+	case CURLE_HTTP_RETURNED_ERROR:
+	// Read/write errors concern local data or callbacks, not socket I/O.
+	case CURLE_READ_ERROR:
+	case CURLE_WRITE_ERROR:
+	case CURLE_ABORTED_BY_CALLBACK:
+	case CURLE_OUT_OF_MEMORY:
+	case CURLE_RANGE_ERROR:
+	case CURLE_BAD_DOWNLOAD_RESUME:
+	case CURLE_BAD_FUNCTION_ARGUMENT:
+	case CURLE_TOO_MANY_REDIRECTS:
+	case CURLE_UNKNOWN_OPTION:
+	case CURLE_BAD_CONTENT_ENCODING:
+	case CURLE_FILESIZE_EXCEEDED:
+	case CURLE_SEND_FAIL_REWIND:
+	case CURLE_RECURSIVE_API_CALL:
+	case CURLE_AUTH_ERROR:
+	case CURLE_TOO_LARGE:
+		error.type = HTTPRequestErrorType::PROCESSING;
+		break;
+	default:
+		error.type = HTTPRequestErrorType::UNKNOWN;
+		break;
+	}
+	error.message = HTTPFSUtil::DescribeRequestError(curl_easy_strerror(result), os_errno);
+	return error;
+}
