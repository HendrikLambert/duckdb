-			     HTTPFSUtil::DescribeRequestError(curl_easy_strerror(res), static_cast<int>(os_errno))});
+			response->SetTransportError(GetTransportError(res, static_cast<int>(os_errno)));
 			return response;
 		}
 		if (include_body) {
diff --git a/src/http/httpfs_httplib_client.cpp b/src/http/httpfs_httplib_client.cpp
index db97e62..1840961 100644
--- a/src/http/httpfs_httplib_client.cpp
+++ b/src/http/httpfs_httplib_client.cpp
@@ -7,6 +7,24 @@
 
 namespace duckdb {
 
+static HTTPTransportErrorType GetTransportErrorType(duckdb_httplib_openssl::Error error) {
+	switch (error) {
+	case duckdb_httplib_openssl::Error::ConnectionTimeout:
+	case duckdb_httplib_openssl::Error::Timeout:
+		return HTTPTransportErrorType::TIMEOUT;
+	case duckdb_httplib_openssl::Error::Connection:
+	case duckdb_httplib_openssl::Error::ProxyConnection:
+		return HTTPTransportErrorType::CONNECT;
+	case duckdb_httplib_openssl::Error::SSLConnection:
+	case duckdb_httplib_openssl::Error::SSLLoadingCerts:
+	case duckdb_httplib_openssl::Error::SSLServerVerification:
+	case duckdb_httplib_openssl::Error::SSLServerHostnameVerification:
+		return HTTPTransportErrorType::TLS;
+	default:
+		return HTTPTransportErrorType::UNKNOWN;
+	}
+}
+
 class HTTPFSClient : public HTTPClient {
 private:
 	class GetTransferState {
@@ -284,8 +302,8 @@ private:
 			return TransformResponse(response);
 		} else {
 			auto result = make_uniq<HTTPResponse>(HTTPStatusCode::INVALID);
-			result->SetTransportError(
-			    {HTTPTransportErrorType::UNKNOWN, HTTPFSUtil::DescribeRequestError(to_string(res.error()), os_errno)});
+			result->SetTransportError({GetTransportErrorType(res.error()),
+			                           HTTPFSUtil::DescribeRequestError(to_string(res.error()), os_errno)});
 			return result;
 		}
 	}
