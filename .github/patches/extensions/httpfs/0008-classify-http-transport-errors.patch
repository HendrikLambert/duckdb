 	RunCurlTerminalTransportErrorIsNotReused();
 }
 
+TEST_CASE("HTTP clients classify truncated transfers as transport failures", "[httpfs][request-session]") {
+	for (const auto &backend : {"curl", "httplib"}) {
+		DYNAMIC_SECTION(backend) {
+			MockS3ServerConfig config;
+			config.range.behavior = MockS3RangeBehavior::TRUNCATE_TRANSFER;
+			config.range.behavior_requests = 1;
+			MockS3Server server(std::move(config));
+			DuckDB db(nullptr);
+			Connection con(db);
+			HTTPTestHelper::Configure(db, con, 0, backend);
+			HTTPTestHelper::RequireQueryOk(con, "BEGIN TRANSACTION");
+			auto session = db.instance->config.GetHTTPTransportManager().CreateSession(*con.context, server.HTTPPath());
+			HTTPHeaders headers;
+			headers.Set("Range", "bytes=0-3");
+			GetRequestInfo request(server.HTTPPath(), headers, session.Parameters(), nullptr, nullptr);
+			request.try_request = true;
+			auto response = session.Request(request);
+			REQUIRE(response);
+			CHECK(response->HasRequestError());
+			CHECK(response->HasTransportError());
+			CHECK(response->GetRequestError().type == HTTPRequestErrorType::TRANSPORT);
+			CHECK(response->ShouldRetry());
+			CHECK_FALSE(response->Success());
+			CHECK(HTTPTestHelper::CountRangeRequests(server.Observations(), 206) == 1);
+			HTTPTestHelper::RequireQueryOk(con, "COMMIT");
+		}
+	}
+}
+
+TEST_CASE("httplib content handler cancellation is a processing error", "[httpfs][request-session]") {
+	MockS3Server server {MockS3ServerConfig()};
+	DuckDB db(nullptr);
+	Connection con(db);
+	HTTPTestHelper::Configure(db, con, 2, "httplib");
+	HTTPTestHelper::RequireQueryOk(con, "BEGIN TRANSACTION");
+	auto session = db.instance->config.GetHTTPTransportManager().CreateSession(*con.context, server.HTTPPath());
+	GetRequestInfo request(
+	    server.HTTPPath(), HTTPHeaders(), session.Parameters(), [](const HTTPResponse &) { return true; },
+	    [](const_data_ptr_t, idx_t) { return false; });
+	request.try_request = true;
+	auto response = session.Request(request);
+	REQUIRE(response);
+	CHECK(response->HasRequestError());
+	CHECK_FALSE(response->HasTransportError());
+	CHECK(response->GetRequestError().type == HTTPRequestErrorType::PROCESSING);
+	CHECK(StringUtil::Contains(response->GetError(), "Connection handling canceled"));
+	CHECK_FALSE(response->Success());
+	CHECK(HTTPTestHelper::CountRequests(server.Observations(), "GET", 200) == 1);
+	HTTPTestHelper::RequireQueryOk(con, "COMMIT");
+}
